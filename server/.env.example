PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/play_arena
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d

# Razorpay Payment Configuration
